	partition Dim_Estacion = m
		mode: import
		queryGroup: 02_MODELO
		source =
				let
				    Origen = #"01_STG_Estaciones",
				
				    Conteo = Table.Group(
				        #"01_STG_EstacionServicio",
				        {"id_estacion"},
				        {
				            {
				                "cantidad_servicios",
				                Table.RowCount,
				                Int64.Type
				            }
				        }
				    ),
				
				    Unida = Table.NestedJoin(
				        Origen,
				        {"id_estacion"},
				        Conteo,
				        {"id_estacion"},
				        "conteo",
				        JoinKind.LeftOuter
				    ),
				
				    Expandida = Table.ExpandTableColumn(
				        Unida,
				        "conteo",
				        {"cantidad_servicios"},
				        {"cantidad_servicios"}
				    ),
				
				    Seleccion = Table.SelectColumns(
				        Expandida,
				        {
				            "id_estacion",
				            "nombre",
				            "tipo",
				            "estructura",
				            "direccion",
				            "barrio",
				            "comuna",
				            "numero_comuna",
				            "latitud",
				            "longitud",
				            "cantidad_servicios",
				            "flag_calidad"
				        }
				    ),
				
				    Tipos = Table.TransformColumnTypes(
				        Seleccion,
				        {
				            {"id_estacion", Int64.Type},
				            {"numero_comuna", Int64.Type},
				            {"latitud", type number},
				            {"longitud", type number},
				            {"cantidad_servicios", Int64.Type}
				        }
				    ),
				
				    Ordenada = Table.Sort(
				        Tipos,
				        {
				            {"id_estacion", Order.Ascending}
				        }
				    )
				
				in
				    Ordenada

	annotation PBI_ResultType = Table

